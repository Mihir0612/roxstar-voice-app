# Environment contract for the Roxstar backend (D29).
# Names only -- never commit real values. Production reads these from
# GCP Secret Manager and injects them at deploy time.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://roxstar:roxstar_local_dev@localhost:5433/roxstar
DATABASE_SSL=false
# The test suite uses a SEPARATE database (roxstar_test) so a running backend's
# spin scheduler cannot claim the suite's spins. Create it once with:
#   docker exec roxstar-postgres psql -U roxstar -d postgres #     -c "CREATE DATABASE roxstar_test OWNER roxstar;"
DATABASE_POOL_MAX=10

# --- Auth (D8) --------------------------------------------------------------
# Must be >= 16 chars. The server refuses to start in production if this is
# left at the development default.
AUTH_SECRET=dev-only-insecure-secret-change-me
AUTH_TOKEN_TTL_SECONDS=604800

# --- CORS (D23) -------------------------------------------------------------
# Comma-separated. EMPTY IN PRODUCTION MEANS DENY ALL BROWSER ORIGINS.
# The Android client sends no Origin header and is unaffected.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging (D6) -----------------------------------------------------------
LOG_LEVEL=info

# --- Spin engine (PDF: one elimination every 5 seconds) ---------------------
SPIN_ELIMINATION_INTERVAL_MS=5000
SPIN_MIN_PARTICIPANTS=3
SPIN_MAX_PARTICIPANTS=20
SPIN_SCHEDULER_TICK_MS=500
SPIN_MAX_CATCHUP_LAG_MS=15000

# --- Presence (D13) ---------------------------------------------------------
PRESENCE_GRACE_MS=15000
PRESENCE_SWEEP_TICK_MS=1000

# --- Rate limiting (D22) ----------------------------------------------------
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SPIN_START_MAX=6

ENABLE_BACKGROUND_WORKERS=true
